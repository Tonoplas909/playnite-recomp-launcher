<UserControl x:Class="RecompLauncherLibrary.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="Chemin de recomplauncher.exe (vide = détection automatique)" />
        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Parcourir..." Margin="8,0,0,0" Click="Browse_Click" />
            <TextBox Text="{Binding Settings.ExePath, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
    </StackPanel>
</UserControl>
